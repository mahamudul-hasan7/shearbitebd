NEXT_PUBLIC_APP_NAME=ShareBite BD
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_PROVIDER=openstreetmap
DATABASE_URL="postgresql://postgres:password@localhost:5432/sharebite_bd?schema=public"
# npm run db:setup can create a project-local PostgreSQL on 127.0.0.1:5433.
# It writes its generated DATABASE_URL to the gitignored .env.local.
# Set true when serving the app over HTTPS. Keep false for the local varsity demo.
AUTH_COOKIE_SECURE=false
# Local setup generates OTP_SECRET in .env.local. For hosting, set a random secret
# of at least 32 characters; never prefix it with NEXT_PUBLIC_.
