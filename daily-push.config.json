{
  "remote": "origin",
  "branch": "segmented/16-commits",
  "minCommits": 5,
  "maxCommits": 5,
  "schedule": {
    "startDate": "2026-09-21",
    "times": ["17:00", "21:00", "23:00"],
    "commitsPerRun": 5,
    "runMissed": true
  },
  "campaign": {
    "enabled": false,
    "id": "three-daily-slots",
    "startDate": "2026-09-21",
    "batchCounts": [5],
    "maxConsecutivePushDays": 2,
    "restDaysAfterStreak": 1
  },
  "dateMode": {
    "enabled": true,
    "timeZone": "Asia/Dhaka",
    "backupBranchPrefix": "backup/daily-date"
  },
  "safety": {
    "requireCleanTree": true,
    "stopOnDivergence": true,
    "checks": ["lint", "typecheck", "build"]
  }
}
