{
  "name": "sharebite-bd-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/ensure-database.mjs",
    "build": "next build",
    "start": "next start",
    "predemo": "node scripts/ensure-database.mjs",
    "demo": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:i18n:browser": "node scripts/test-i18n-browser.mjs",
    "test:i18n": "node --import tsx --test tests/i18n.test.ts",
    "test:samples:browser": "node scripts/test-sample-browser.mjs",
    "test:donations:browser": "node scripts/test-donation-browser.mjs",
    "test:mobile:browser": "node scripts/test-mobile-browser.mjs",
    "test:duty:browser": "node scripts/test-duty-browser.mjs",
    "test:progress": "node --import tsx --test tests/rescue-progress.test.ts",
    "test:progress:browser": "node scripts/test-progress-browser.mjs",
    "test:donor-mobile:browser": "node scripts/test-donor-mobile-browser.mjs",
    "test:performance:browser": "node scripts/test-performance-browser.mjs",
    "test:distribution:browser": "node scripts/test-distribution-browser.mjs",
    "test:cleanup:browser": "node scripts/test-cleanup-browser.mjs",
    "test:auth": "node --test tests/auth.integration.test.mjs",
    "test:photos:browser": "node scripts/test-photo-browser.mjs",
    "test:incidents:browser": "node scripts/test-incident-browser.mjs",
    "test:maps:browser": "node scripts/test-map-browser.mjs",
    "test:requests:browser": "node scripts/test-request-browser.mjs",
    "db:generate": "prisma generate",
    "db:push": "node scripts/db-command.mjs db push",
    "db:seed": "node scripts/db-command.mjs db seed",
    "db:studio": "node scripts/db-command.mjs studio",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "db:local:status": "node scripts/local-postgres.mjs status",
    "db:migrate": "node scripts/db-command.mjs migrate deploy",
    "db:import": "tsx scripts/import-legacy-data.ts",
    "db:setup": "node scripts/setup-database.mjs",
    "db:admin": "tsx scripts/setup-local-admin.ts",
    "db:verify": "tsx scripts/verify-account.ts",
    "db:incident": "tsx scripts/review-incident.ts",
    "git:check": "node scripts/check-unpushed.mjs",
    "git:setup": "node scripts/setup-git-hooks.mjs",
    "git:daily:status": "node scripts/daily-push.mjs --dry-run",
    "git:daily:push": "node scripts/daily-push.mjs",
    "git:daily:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-daily-push.ps1",
    "git:daily:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/remove-daily-push.ps1",
    "postinstall": "node scripts/setup-git-hooks.mjs",
    "test:admin:browser": "node scripts/test-admin-browser.mjs",
    "test:auth:browser": "node scripts/test-auth-pages-browser.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.65.0",
    "prisma": "^6.4.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
