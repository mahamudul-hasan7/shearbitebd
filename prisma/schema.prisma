// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  DONOR
  NGO
  VOLUNTEER
  ADMIN
}

enum VerificationKind {
  PICKUP
  DELIVERY
}

enum PhotoPurpose {
  DONATION
  RECEIPT
  DISTRIBUTION
  INCIDENT
}

enum IncidentDecision {
  RESUME
  REJECT_FOOD
}

enum MissionRouteStage {
  assigned
  en_route_pickup
  at_pickup
  cargo_loaded
  en_route_dropoff
  completed
}

enum DonorType {
  INDIVIDUAL
  CAFETERIA
  RESTAURANT
  BAKERY
  EVENT_ORGANIZER
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum FoodCategory {
  COOKED_MEAL
  BAKERY
  PRODUCE
  GROCERIES
  DAIRY
  BEVERAGE
  OTHER
}

enum DietaryType {
  HALAL
  VEGETARIAN
  VEGAN
  CONTAINS_MEAT
  GLUTEN_FREE
  OTHER
}

enum StorageCondition {
  AMBIENT
  REFRIGERATED
  FROZEN
  HOT_HOLDING
}

enum FoodCondition {
  FRESHLY_PREPARED
  SAME_DAY
  PACKAGED
}

enum QuantityUnit {
  PORTIONS
  MEALS
  KILOGRAMS
  PACKETS
  TRAYS
  LITRES
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DonationStatus {
  DRAFT
  PUBLISHED
  AVAILABLE
  RESERVED
  ASSIGNED
  PICKED_UP
  DELIVERED
  DISTRIBUTED
  EXPIRED
  CANCELLED
  DISPUTED
}

enum ClaimStatus {
  RESERVED
  ASSIGNED
  PICKED_UP
  DELIVERED
  DISTRIBUTED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum RequestStatus {
  DRAFT
  PENDING_REVIEW
  FINDING_MATCH
  MATCHED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum RequestType {
  ONE_TIME
  RECURRING
  EMERGENCY
}

enum TransportMethod {
  WALKING
  BICYCLE
  MOTORCYCLE
  VAN
  CAR
}

enum NotificationType {
  URGENT
  CLAIM
  VOLUNTEER
  PICKUP
  DELIVERY
  NEARBY_DONATION
  IMPACT
  SYSTEM
}

enum IncidentType {
  DAMAGED_FOOD
  WRONG_QUANTITY
  LATE_DELIVERY
  WRONG_ITEM
  SAFETY_CONCERN
  OTHER
}

enum IncidentStatus {
  SUBMITTED
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum NGOTeamRole {
  OWNER
  COORDINATOR
  FIELD_STAFF
  VIEWER
}

enum NGOTeamMemberStatus {
  ACTIVE
  INVITED
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  username         String?           @unique
  // Plaintext storage is temporary and explicitly requested for the varsity project.
  password         String?
  normalizedPhone  String?           @unique
  registrationDetails Json          @default("{}")
  displayName      String
  phone            String?
  avatarUrl        String?
  role             UserRole          @default(DONOR)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  donorProfile     DonorProfile?
  ngoProfile       NGOProfile?
  volunteerProfile VolunteerProfile?
  notifications    Notification[]
  preferences      UserPreference?
  reportedIncidents IncidentReport[]
  sessions         AuthSession[]
  issuedChallenges HandoverChallenge[]
  photos           PhotoAsset[]
  incidentReviews  IncidentReview[]
  addresses        Address[]
  accountReviewsReceived AccountReview[] @relation("ReviewedAccount")
  accountReviewsAuthored AccountReview[] @relation("AccountReviewer")
  verificationDocuments VerificationDocument[]

  @@index([role, isActive, createdAt])
  @@map("users")
}

model Address {
  id          String   @id @default(cuid())
  label       String
  division    String   @default("Dhaka")
  district    String   @default("Dhaka")
  city        String   @default("Dhaka")
  area        String
  addressLine String
  postalCode  String?
  landmark    String?
  latitude    Float?
  longitude   Float?
  foodRequests FoodRequest[]
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  donations   Donation[]
  volunteerProfiles VolunteerProfile[]
  distributions DistributionRecord[]

  @@map("addresses")
  @@index([ownerId])
}

model AuthSession {
  tokenHash String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model DonorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  donorType          DonorType          @default(RESTAURANT)
  organizationName   String?
  verificationStatus VerificationStatus @default(PENDING)
  bfsaCertNumber     String?
  rating             Float?             @default(5.0)
  totalDonations     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations          Donation[]
  impactRecords      ImpactRecord[]

  @@map("donor_profiles")
  @@index([verificationStatus])
}

model NGOProfile {
  verificationDocumentId String? @unique
  verificationDocument VerificationDocument? @relation("NGOCurrentDocument", fields: [verificationDocumentId], references: [id], onDelete: SetNull)
  id                      String             @id @default(cuid())
  userId                  String             @unique
  organizationName        String
  registrationNumber      String
  summary                 String
  mission                 String
  vision                  String
  values                  String[]           @default([])
  beneficiaryTypes        String[]           @default([])
  acceptedFoodCategories  FoodCategory[]     @default([])
  authorizedContactUserId String?
  serviceAreas            String[]           @default([])
  capacityMealsPerDay     Int                @default(100)
  peopleHelped            Int                @default(0)
  foundedYear             Int                @default(2020)
  publicEmail             String
  publicPhone             String
  galleryUrls             String[]           @default([])
  verificationStatus      VerificationStatus @default(PENDING)
  verificationDocName     String?
  rating                  Float?             @default(5.0)
  completedRescues        Int                @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers             NGOTeamMember[]
  claims                  Claim[]
  requests                FoodRequest[]
  receipts                DeliveryReceipt[]
  distributionRecords     DistributionRecord[]
  impactRecords           ImpactRecord[]

  @@map("ngo_profiles")
  @@index([verificationStatus])
}

model NGOTeamMember {
  id           String              @id @default(cuid())
  ngoProfileId String
  name         String
  email        String
  role         NGOTeamRole         @default(COORDINATOR)
  status       NGOTeamMemberStatus @default(ACTIVE)
  joinedAt     DateTime?
  createdAt    DateTime            @default(now())

  ngoProfile   NGOProfile          @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)

  @@map("ngo_team_members")
}

model VolunteerProfile {
  verificationDocumentId String? @unique
  verificationDocument VerificationDocument? @relation("VolunteerCurrentDocument", fields: [verificationDocumentId], references: [id], onDelete: SetNull)
  id                   String             @id @default(cuid())
  userId               String             @unique
  addressId            String?
  serviceAreas         String[]           @default([])
  transportMethod      TransportMethod    @default(BICYCLE)
  availability         String[]           @default([])
  isOnDuty             Boolean            @default(false)
  dutyStartedAt        DateTime?
  dutyVersion          Int                @default(0)
  verificationStatus   VerificationStatus @default(PENDING)
  identityDocumentName String?
  completedRescues     Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              Address?           @relation(fields: [addressId], references: [id])
  claims               Claim[]

  @@map("volunteer_profiles")
  @@index([verificationStatus])
}

model Donation {
  id                    String            @id @default(cuid())
  donorProfileId        String
  preferredNgoProfileId String?
  title                 String
  description           String
  category              FoodCategory
  dietaryTypes          DietaryType[]     @default([HALAL])
  quantityValue         Float
  quantityUnit          QuantityUnit      @default(MEALS)
  estimatedMeals        Int
  preparationTime       DateTime
  safePickupDeadline    DateTime
  storageCondition      StorageCondition  @default(HOT_HOLDING)
  foodCondition         FoodCondition     @default(FRESHLY_PREPARED)
  allergens             String[]          @default([])
  photoUrls             String[]          @default([])
  sampleImageId         String?
  specialInstructions   String?
  priority              PriorityLevel     @default(HIGH)
  status                DonationStatus    @default(AVAILABLE)

  // Pickup fields
  pickupLatitude        Float?
  pickupLongitude       Float?
  pickupAddressId       String
  approximateArea       String
  distanceKm            Float?
  contactName           String
  contactPhone          String
  contactEmail          String?
  windowStart           DateTime
  windowEnd             DateTime
  directions            String?

  // Safety Declaration
  safetyFreshlyPrepared Boolean           @default(true)
  safetyProperlyCovered Boolean           @default(true)
  safetyNoSpoilage      Boolean           @default(true)
  safetyStoredCorrectly Boolean           @default(true)
  safetyAllergensDisclosed Boolean        @default(true)
  safetyDeadlineConfirmed Boolean         @default(true)
  safetyAccuracyConfirmed Boolean         @default(true)
  safetyDeclaredAt      DateTime          @default(now())

  publishedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  donor                 DonorProfile      @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)
  pickupAddress         Address           @relation(fields: [pickupAddressId], references: [id])
  claims                Claim[]
  photos                PhotoAsset[]

  @@map("donations")
}

model Claim {
  deliveryAddressSnapshot Json?
  id                        String             @id @default(cuid())
  donationId                String
  foodRequestId             String?
  requestMealsAllocated     Int                @default(0)
  ngoProfileId              String
  volunteerProfileId        String?
  status                    ClaimStatus        @default(RESERVED)
  routeStage                MissionRouteStage  @default(assigned)
  incidentHoldStatus        ClaimStatus?
  matchScore                Int                @default(90)
  reservedAt                DateTime           @default(now())
  assignedAt                DateTime?
  pickedUpAt                DateTime?
  deliveredAt               DateTime?
  distributedAt             DateTime?
  estimatedPickupAt         DateTime?
  estimatedDeliveryAt       DateTime?
  pickupVerificationToken   String?
  deliveryVerificationToken String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  donation                  Donation           @relation(fields: [donationId], references: [id], onDelete: Cascade)
  foodRequest               FoodRequest?       @relation(fields: [foodRequestId], references: [id], onDelete: SetNull)
  ngo                       NGOProfile         @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)
  volunteer                 VolunteerProfile?  @relation(fields: [volunteerProfileId], references: [id])
  deliveryReceipt           DeliveryReceipt?
  distributionRecord        DistributionRecord?
  impactRecord              ImpactRecord?
  incidentReports           IncidentReport[]
  challenges                HandoverChallenge[]
  photos                    PhotoAsset[]

  @@map("claims")
  @@index([status, createdAt])
  // Active claim uniqueness is enforced by the partial index in migration 002.
  @@index([donationId])
  @@index([foodRequestId])
}

model HandoverChallenge {
  id             String           @id @default(cuid())
  claimId        String
  kind           VerificationKind
  codeHash       String
  issuedByUserId String
  issuedAt       DateTime         @default(now())
  expiresAt      DateTime
  attempts       Int              @default(0)
  consumedAt     DateTime?

  claim          Claim            @relation(fields: [claimId], references: [id], onDelete: Cascade)
  issuer         User             @relation(fields: [issuedByUserId], references: [id], onDelete: Cascade)

  @@unique([claimId, kind])
  @@index([expiresAt])
  @@map("handover_challenges")
}

model PhotoAsset {
  id           String       @id @default(uuid())
  ownerId      String
  purpose      PhotoPurpose
  originalName String
  mimeType     String       @default("image/webp")
  byteSize     Int
  width        Int
  height       Int
  data         Bytes
  donationId   String?
  claimId      String?
  attachedAt   DateTime?
  createdAt    DateTime     @default(now())

  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  donation     Donation?    @relation(fields: [donationId], references: [id], onDelete: Cascade)
  claim        Claim?       @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([donationId])
  @@index([claimId])
  @@map("photo_assets")
}

model FoodRequest {
  id                      String          @id @default(cuid())
  ngoProfileId            String
  deliveryAddressId       String?
  mealsFulfilled          Int             @default(0)
  submissionKey           String?
  submissionHash          String?
  title                   String
  requestType             RequestType     @default(ONE_TIME)
  priority                PriorityLevel   @default(HIGH)
  priorityReason          String?
  supportingDocumentNames String[]        @default([])
  purpose                 String
  recipientType           String
  categories              FoodCategory[]  @default([])
  dietaryTypes            DietaryType[]   @default([HALAL])
  specificPreferences     String?
  allergensOrRestrictions String[]        @default([])
  peopleToServe           Int
  mealsNeeded             Int
  neededWhen              String          @default("TODAY")
  neededBy                DateTime
  preferredTimeSlot       String?
  locationType            String          @default("SHELTER")
  deliveryArea            String
  deliveryCity            String          @default("Dhaka")
  deliveryLatitude        Float?
  deliveryLongitude       Float?
  deliveryAddressLine     String
  deliveryLandmark        String?
  deliveryInstructions    String?
  notes                   String?
  status                  RequestStatus   @default(PENDING_REVIEW)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  ngo                     NGOProfile      @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)
  deliveryAddress         Address?        @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)
  claims                  Claim[]

  @@unique([ngoProfileId, submissionKey])
  @@index([ngoProfileId, status, neededBy])
  @@map("food_requests")
}

model DeliveryReceipt {
  id                        String       @id @default(cuid())
  claimId                   String       @unique
  ngoProfileId              String
  expectedQuantity          Float
  actualQuantity            Float
  quantityUnit              QuantityUnit @default(MEALS)
  foodCondition             String       @default("GOOD")
  quantityMismatchConfirmed Boolean      @default(false)
  distributionBlocked       Boolean      @default(false)
  verificationMethod        String       @default("QR")
  notes                     String?
  photoNames                String[]     @default([])
  photoUrls                 String[]     @default([])
  receivedAt                DateTime     @default(now())
  createdAt                 DateTime     @default(now())

  claim                     Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ngo                       NGOProfile   @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)

  @@map("delivery_receipts")
}

model DistributionRecord {
  id                          String     @id @default(cuid())
  claimId                     String     @unique
  ngoProfileId                String
  beneficiariesServed         Int
  mealsDistributed            Int
  adultsServed                Int?
  childrenServed              Int?
  distributedAt               DateTime   @default(now())
  addressId                   String
  notes                       String?
  photoUrls                   String[]   @default([])
  photoNames                  String[]   @default([])
  beneficiaryConsentConfirmed Boolean    @default(true)
  createdAt                   DateTime   @default(now())

  claim                       Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  ngo                         NGOProfile @relation(fields: [ngoProfileId], references: [id], onDelete: Cascade)
  distributionAddress         Address    @relation(fields: [addressId], references: [id])

  @@map("distribution_records")
}

model ImpactRecord {
  id                        String        @id @default(cuid())
  claimId                   String?       @unique
  donorProfileId            String?
  ngoProfileId              String?
  recordedAt                DateTime      @default(now())
  mealsRescued              Int
  foodWeightKg              Float
  beneficiariesServed       Int
  estimatedCo2PreventedKg   Float
  estimatedWaterSavedLitres Float?
  estimateMethodology       String

  claim                     Claim?        @relation(fields: [claimId], references: [id], onDelete: SetNull)
  donor                     DonorProfile? @relation(fields: [donorProfileId], references: [id], onDelete: SetNull)
  ngo                       NGOProfile?   @relation(fields: [ngoProfileId], references: [id], onDelete: SetNull)

  @@map("impact_records")
}

model IncidentReport {
  id                     String         @id @default(cuid())
  claimId                String
  reportedByUserId       String
  type                   IncidentType   @default(SAFETY_CONCERN)
  severity               PriorityLevel  @default(HIGH)
  description            String
  evidenceUrls           String[]       @default([])
  preferredContactMethod String         @default("PHONE")
  status                 IncidentStatus @default(SUBMITTED)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  resolvedAt             DateTime?
  submissionKey          String?
  submissionHash         String?
  blocksRescue           Boolean        @default(true)
  decision               IncidentDecision?

  claim                  Claim          @relation(fields: [claimId], references: [id], onDelete: Cascade)
  reportedByUser         User           @relation(fields: [reportedByUserId], references: [id], onDelete: Cascade)
  reviews                IncidentReview[]

  @@unique([reportedByUserId, submissionKey])
  @@index([claimId, status])
  @@map("incident_reports")
  @@index([status, createdAt])
}

model AccountReview {
  verificationDocumentId String?
  verificationDocument VerificationDocument? @relation(fields: [verificationDocumentId], references: [id], onDelete: Restrict)
  id String @id @default(cuid())
  targetUserId String
  actorUserId String
  actorLabel String
  previousStatus VerificationStatus
  status VerificationStatus
  note String
  submissionKey String @unique
  previousUpdatedAt DateTime
  createdAt DateTime @default(now())
  target User @relation("ReviewedAccount", fields: [targetUserId], references: [id], onDelete: Restrict)
  actor User @relation("AccountReviewer", fields: [actorUserId], references: [id], onDelete: Restrict)
  @@index([targetUserId, createdAt])
  @@index([createdAt])
  @@map("account_reviews")
}

model VerificationDocument {
  id String @id @default(uuid())
  ownerId String
  kind String
  originalName String
  mimeType String
  byteSize Int
  width Int?
  height Int?
  pages Int?
  data Bytes
  uploadKey String
  sourceHash String
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ngoProfile NGOProfile? @relation("NGOCurrentDocument")
  volunteerProfile VolunteerProfile? @relation("VolunteerCurrentDocument")
  reviews AccountReview[]
  @@unique([ownerId, uploadKey])
  @@index([ownerId, createdAt])
  @@map("verification_documents")
}

model IncidentReview {
  id           String            @id @default(cuid())
  incidentId   String
  actorUserId  String?
  actorLabel   String
  status       IncidentStatus
  decision     IncidentDecision?
  note         String
  createdAt    DateTime          @default(now())

  incident     IncidentReport    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor        User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(SYSTEM)
  priority  PriorityLevel    @default(MEDIUM)
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model UserPreference {
  id                 String   @id @default(cuid())
  userId             String   @unique
  pushNotifications  Boolean  @default(true)
  emailNotifications Boolean  @default(true)
  locationPermission String   @default("GRANTED")
  language           String   @default("BN")
  textSize           String   @default("MEDIUM")
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
